<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by gen_fluffy_content.py. Loaded only when Twokay's Plushies is active (see LoadFolders.xml). -->
<Patch>
  <!-- A big fluffy plushie next to a bed counts as a plushie for Plushies' sleep moods. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="Plushie_BigFluffy"]/comps</xpath>
    <value>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <Comfort>0.01</Comfort>
        </statOffsets>
        <maxSimultaneous>10</maxSimultaneous>
        <maxDistance>2</maxDistance>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Plushie_BigFluffy"]/placeWorkers</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Plushie_BigFluffy"]/placeWorkers</xpath>
      <value>
        <li>PlaceWorker_ShowFacilitiesConnections</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Plushie_BigFluffy"]</xpath>
      <value>
        <placeWorkers>
          <li>PlaceWorker_ShowFacilitiesConnections</li>
        </placeWorkers>
      </value>
    </nomatch>
  </Operation>

  <!-- Same beds Plushies links its own plushie to. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[contains(label,'bed') or contains(label,'crib') or @Name="BasicBedBase"]/comps/li[@Class = "CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
    <value>
      <li>Plushie_BigFluffy</li>
    </value>
  </Operation>
</Patch>
